{
  "manifest_version": 3,
  "name": "Edge-Browser-Backup",
  "version": "1.9.0",
  "description": "标签与收藏、扩展源码，备份统一写进插件目录的 backups/；扩展源码由附带脚本复制，插件内可直接删除。",
  "permissions": ["tabs", "tabGroups", "bookmarks", "storage", "management"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Edge-Browser-Backup",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
